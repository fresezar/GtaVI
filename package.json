{
  "name": "gta-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:static": "cross-env STATIC_EXPORT=1 next build",
    "validate": "node scripts/validate-content.mjs",
    "import:pins": "node scripts/import-pins.mjs",
    "prebuild": "npm run validate",
    "prebuild:static": "npm run validate",
    "deploy": "npm run validate && npm run tiles && cross-env STATIC_EXPORT=1 NEXT_PUBLIC_SITE_URL=https://sixstargta.com next build && npx --yes wrangler@4 deploy",
    "media": "node scripts/optimize-media.mjs && node scripts/make-logo.mjs && node scripts/make-og.mjs",
    "short": "node scripts/make-short.mjs",
    "tiles": "node scripts/fetch-tiles.mjs",
    "import:gtadb": "node scripts/import-gtadb.mjs",
    "import:community": "node scripts/import-community.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^7.0.3",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
